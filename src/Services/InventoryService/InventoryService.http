@InventoryService_HostAddress = http://localhost:5005

GET {{InventoryService_HostAddress}}/api/inventory
Accept: application/json

###

GET {{InventoryService_HostAddress}}/api/inventory/product/11111111-1111-1111-1111-111111111111
Accept: application/json

###

POST {{InventoryService_HostAddress}}/api/inventory
Content-Type: application/json

{
	"productId": "11111111-1111-1111-1111-111111111111",
	"productName": "Laptop Pro 15",
	"quantity": 120
}

###

PATCH {{InventoryService_HostAddress}}/api/inventory/11111111-1111-1111-1111-111111111111/quantity
Content-Type: application/json

{
	"quantity": 90
}

###
